{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "history-row.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "run_kind", "skill", "commit", "timestamp", "status", "passed", "metrics", "detail_file"],
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "string", "minLength": 1 },
    "run_kind": { "enum": ["main", "nightly"] },
    "skill": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "minLength": 1 },
    "short_sha": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "status": { "enum": ["ok", "error"] },
    "passed": { "type": "boolean" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass_rate", "mean_score", "pass_at_k", "pass_to_k", "flaky_count", "tokens", "turns", "tool_calls", "wall_time_ms"],
      "properties": {
        "pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "mean_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "pass_at_k": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "pass_to_k": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "flaky_count": { "type": "integer", "minimum": 0 },
        "tokens": { "type": "number", "minimum": 0 },
        "turns": { "type": "number", "minimum": 0 },
        "tool_calls": { "type": "number", "minimum": 0 },
        "wall_time_ms": { "type": "number", "minimum": 0 }
      }
    },
    "model": { "type": ["string", "null"] },
    "vally_version": { "type": ["string", "null"] },
    "workflow_run_url": { "type": ["string", "null"] },
    "detail_file": { "type": "string", "pattern": "^runs/.+\\.json$" },
    "error_message": { "type": ["string", "null"] }
  }
}
