{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "uplift-comparison.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["type", "baseline", "treatment", "summary", "stimuli", "unmatchedBaseline", "unmatchedTreatment"],
  "properties": {
    "type": { "const": "comparison" },
    "baseline": { "type": "string", "minLength": 1 },
    "treatment": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "required": ["trialCount", "erroredCount", "meanScore", "ciLow", "ciHigh", "wins", "ties", "losses", "winRate"],
      "properties": {
        "trialCount": { "type": "integer", "minimum": 1 },
        "erroredCount": { "const": 0 },
        "meanScore": { "type": "number", "minimum": -1, "maximum": 1 },
        "ciLow": { "type": "number" },
        "ciHigh": { "type": "number" },
        "wins": { "type": "integer", "minimum": 0 },
        "ties": { "type": "integer", "minimum": 0 },
        "losses": { "type": "integer", "minimum": 0 },
        "winRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "stimuli": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stimulusName", "trials"],
        "properties": {
          "stimulusName": { "type": "string", "pattern": "^[a-z0-9-]+--.+" },
          "trials": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["score"],
              "properties": {
                "score": { "type": "number", "minimum": -1, "maximum": 1 },
                "errored": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "unmatchedBaseline": { "type": "array", "maxItems": 0 },
    "unmatchedTreatment": { "type": "array", "maxItems": 0 }
  }
}
