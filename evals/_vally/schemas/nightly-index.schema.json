{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nightly-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runs"],
  "properties": {
    "schema_version": { "const": 1 },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "timestamp", "status", "commit", "short_sha", "flaky_count", "summary_file"],
        "properties": {
          "run_id": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
          "status": { "enum": ["clean", "inconclusive", "regression"] },
          "commit": { "type": "string", "minLength": 7 },
          "short_sha": { "type": "string", "minLength": 7 },
          "flaky_count": { "type": "integer", "minimum": 0 },
          "summary_file": { "type": "string", "pattern": "^data/nightly-runs/.+\\.json$" }
        }
      }
    }
  }
}
