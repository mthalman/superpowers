{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nightly-run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "run_kind", "timestamp", "source", "publication", "toolchain", "runs_per_stimulus", "status", "flaky_count", "skills", "uplift"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^\\d{8}-\\d{9}-[0-9a-f]{7,}$" },
    "run_kind": { "const": "nightly" },
    "timestamp": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "short_sha"],
      "properties": {
        "commit": { "type": "string", "minLength": 7 },
        "short_sha": { "type": "string", "minLength": 7 }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch"],
      "properties": {
        "branch": { "type": "string", "pattern": "^vally-history/.+" },
        "automation_session_url": { "type": ["string", "null"] }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vally_version", "schema_version"],
      "properties": {
        "vally_version": { "type": "string", "minLength": 1 },
        "schema_version": { "const": 1 }
      }
    },
    "runs_per_stimulus": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["clean", "inconclusive", "regression"] },
    "flaky_count": { "type": "integer", "minimum": 0 },
    "skills": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "passed", "model", "metrics", "detail_file", "delta_from_previous_nightly"],
        "properties": {
          "skill": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "model": { "type": ["string", "null"] },
          "metrics": { "$ref": "#/definitions/metrics" },
          "detail_file": { "type": "string", "pattern": "^data/.+/runs/.+\\.json$" },
          "delta_from_previous_nightly": { "type": ["number", "null"] }
        }
      }
    },
    "uplift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history_file", "comparison_file", "overall", "skills"],
      "properties": {
        "history_file": { "const": "data/uplift/history.jsonl" },
        "comparison_file": { "type": "string", "pattern": "^data/uplift/runs/.+\\.jsonl$" },
        "overall": { "$ref": "#/definitions/comparison" },
        "skills": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/definitions/skillComparison" }
        }
      }
    }
  },
  "definitions": {
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass_rate", "mean_score", "pass_at_k", "pass_to_k", "flaky_count", "tokens", "turns", "tool_calls", "wall_time_ms"],
      "properties": {
        "pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "mean_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "pass_at_k": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "pass_to_k": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "flaky_count": { "type": "integer", "minimum": 0 },
        "tokens": { "type": "number", "minimum": 0 },
        "turns": { "type": "number", "minimum": 0 },
        "tool_calls": { "type": "number", "minimum": 0 },
        "wall_time_ms": { "type": "number", "minimum": 0 }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_count", "mean_score", "ci_low", "ci_high", "wins", "ties", "losses", "win_rate", "verdict"],
      "properties": {
        "trial_count": { "type": "integer", "minimum": 1 },
        "mean_score": { "type": "number", "minimum": -1, "maximum": 1 },
        "ci_low": { "type": "number" },
        "ci_high": { "type": "number" },
        "wins": { "type": "integer", "minimum": 0 },
        "ties": { "type": "integer", "minimum": 0 },
        "losses": { "type": "integer", "minimum": 0 },
        "win_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "verdict": { "enum": ["improvement", "inconclusive", "regression"] }
      }
    },
    "skillComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "baseline_model", "treatment_model", "trial_count", "mean_score", "ci_low", "ci_high", "wins", "ties", "losses", "win_rate", "verdict"],
      "properties": {
        "skill": { "type": "string", "minLength": 1 },
        "baseline_model": { "type": ["string", "null"] },
        "treatment_model": { "type": ["string", "null"] },
        "trial_count": { "type": "integer", "minimum": 1 },
        "mean_score": { "type": "number", "minimum": -1, "maximum": 1 },
        "ci_low": { "type": "number" },
        "ci_high": { "type": "number" },
        "wins": { "type": "integer", "minimum": 0 },
        "ties": { "type": "integer", "minimum": 0 },
        "losses": { "type": "integer", "minimum": 0 },
        "win_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "verdict": { "enum": ["improvement", "inconclusive", "regression"] }
      }
    }
  }
}
